# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=file:./db/custom.db
NEXTAUTH_SECRET=<generate with: openssl rand -hex 32>
NEXTAUTH_URL=http://localhost:3000
REALTIME_PORT=3003
# The realtime broadcast token is a shared secret between the Next.js API and
# the realtime mini-service over localhost. Generate a strong random string.
REALTIME_BROADCAST_TOKEN=<generate with: openssl rand -hex 32>
