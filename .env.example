# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=file:./db/custom.db
NEXTAUTH_SECRET=<generate with: openssl rand -hex 32>
# NEXTAUTH_URL is intentionally omitted. NextAuth auto-detects the URL from
# the request origin, so the same build works locally AND on the deployed
# HTTPS URL. Only set this if you need to force a specific canonical URL.
# NEXTAUTH_URL=https://your-production-domain.com
REALTIME_PORT=3003
# The realtime broadcast token is a shared secret between the Next.js API and
# the realtime mini-service over localhost. Generate a strong random string.
REALTIME_BROADCAST_TOKEN=<generate with: openssl rand -hex 32>
